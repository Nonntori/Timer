<Window x:Class="ShutdownTimer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ShutdownTimer.Converters"
        mc:Ignorable="d"
        Title="Таймер выключения" 
        Height="720" Width="480"
        MinHeight="600" MinWidth="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:ProgressToAngleConverter x:Key="ProgressToAngleConverter"/>
    </Window.Resources>
    
    <Border Background="#0D0D0D" CornerRadius="12" BorderBrush="#2D2D2D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок окна -->
            <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12,2C13.11,2 14,2.9 14,4V6H10V4C10,3.45 9.55,3 9,3C8.45,3 8,3.45 8,4V6H4V4C4,2.9 4.9,2 6,2H12M4,8H14C15.11,8 16,8.9 16,10V13C16,13.55 15.55,14 15,14C14.45,14 14,13.55 14,13V10H4V13C4,13.55 3.55,14 3,14C2.45,14 2,13.55 2,13V10C2,8.9 2.9,8 4,8M4,16H10V18H4V16M12,16H14V18H12V16Z" 
                              Fill="#6060FE" Width="20" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="Таймер выключения" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─" Width="30" Height="30" 
                                Background="Transparent" BorderThickness="0"
                                Foreground="#A0A0A0" FontSize="14"
                                Cursor="Hand" Click="MinimizeButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2D2D2D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="✕" Width="30" Height="30" 
                                Background="Transparent" BorderThickness="0"
                                Foreground="#A0A0A0" FontSize="12"
                                Cursor="Hand" Click="CloseButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E81123"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Основной контент -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    
                    <!-- Подзаголовок -->
                    <TextBlock Text="Компьютер выключится по истечении времени" 
                               FontSize="14" 
                               Foreground="#A0A0A0" 
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>
                    
                    <!-- Круговой таймер -->
                    <Grid Width="280" Height="280" Margin="0,0,0,24">
                        <!-- Фоновый круг -->
                        <Ellipse Stroke="#2D2D2D" StrokeThickness="8" Width="280" Height="280"/>
                        
                        <!-- Progress arc -->
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Grid.RenderTransform>
                            
                            <Path x:Name="ProgressArc" 
                                  Stroke="{Binding AccentColor, Converter={StaticResource ColorToBrushConverter}}" 
                                  StrokeThickness="8" 
                                  Width="280" Height="280"
                                  Stretch="None"
                                  Data="M140,4 A136,136 0 1,1 140,276 A136,136 0 1,1 140,4"/>
                            
                            <Path.Clip>
                                <PathGeometry>
                                    <PathFigure StartPoint="140,140">
                                        <LineSegment Point="140,4"/>
                                        <ArcSegment Point="140,276" Size="136,136" SweepDirection="Clockwise" IsLargeArc="True"/>
                                        <LineSegment Point="140,140"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Clip>
                        </Grid>
                        
                        <!-- Центральный контент -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RemainingTime}" 
                                       FontSize="48" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       FontFamily="Segoe UI"
                                       TextAlignment="Center"/>
                            <TextBlock Text="ДО ВЫКЛЮЧЕНИЯ" 
                                       FontSize="12" 
                                       Foreground="#A0A0A0" 
                                       Margin="0,8,0,0"
                                       TextAlignment="Center"
                                       LetterSpacing="2"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Кнопки быстрого выбора -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Button Content="15 мин" Style="{StaticResource PresetButton}" 
                                Margin="0,0,8,0" Command="{Binding SelectPresetCommand}" CommandParameter="1"/>
                        <Button Content="30 мин" Style="{StaticResource PresetButton}" 
                                Margin="4,0" Command="{Binding SelectPresetCommand}" CommandParameter="2"/>
                        <Button Content="1 час" Style="{StaticResource PresetButton}" 
                                Margin="4,0" Command="{Binding SelectPresetCommand}" CommandParameter="3"/>
                        <Button Content="2 часа" Style="{StaticResource PresetButton}" 
                                Margin="4,0" Command="{Binding SelectPresetCommand}" CommandParameter="4"/>
                    </StackPanel>
                    
                    <!-- Блок выбора действия -->
                    <Border Background="#1A1A1A" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel Margin="16">
                            <TextBlock Text="Действие" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                            
                            <ComboBox ItemsSource="{Binding Source={x:Static System.Enum.GetValues}, ConverterParameter={x:Type local:ShutdownAction}}"
                                      SelectedItem="{Binding SelectedAction}"
                                      Background="#2D2D2D"
                                      Foreground="White"
                                      BorderThickness="0"
                                      Padding="12,10"
                                      FontSize="14">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            
                            <CheckBox Content="Предупредить за 5 минут" 
                                      IsChecked="{Binding WarningEnabled}"
                                      Foreground="#A0A0A0"
                                      FontSize="13"
                                      Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Кнопка запуска -->
                    <Button Content="{Binding StartButtonText}" 
                            Style="{StaticResource ModernButton}"
                            Command="{Binding StartCommand}"
                            HorizontalAlignment="Stretch"
                            Height="50"
                            FontSize="16"/>
                    
                </StackPanel>
            </ScrollViewer>
            
        </Grid>
    </Border>
</Window>
